#!/bin/sh
# 装完之后：杀掉旧进程，再安排登录用户在 PackageKit 完成 bundle 登记后注册输入源。
# 安装器以 root 运行，而输入源是每个用户自己的设置，所以延后到用户的 launchd 里执行。
set -u
APP="/Library/Input Methods/Qingjian.app"
ACTIVATE="$APP/Contents/Resources/activate-after-install.sh"

pkill -x qingjian-macos 2>/dev/null || true

user="$(stat -f%Su /dev/console 2>/dev/null || true)"
if [ -n "$user" ] && [ "$user" != "root" ]; then
    uid="$(id -u "$user")"
    # postinstall 结束后 PackageKit 还会登记 bundle，必须等那一步结束再请求启用。
    label="app.qingjian.inputmethod.activate.$(date +%s).$$"
    plist="$(mktemp /tmp/qingjian-activate.XXXXXX)"
    cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$label</string>
<key>ProgramArguments</key><array>
<string>/bin/sh</string><string>$ACTIVATE</string>
</array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><false/>
</dict></plist>
EOF
    if launchctl asuser "$uid" sudo -u "$user" launchctl bootstrap "gui/$uid" "$plist"; then
        echo "青简：已安排安装结束后刷新输入源"
    else
        echo "青简：安排输入源刷新失败；若没有立即出现，请注销后重新登录"
    fi
    rm -f "$plist"
else
    echo "青简：没找到登录用户，跳过自动注册"
fi
exit 0
